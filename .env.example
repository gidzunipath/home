# Copy to .env.local (Next.js) or .env and fill in real values.
# Never commit files that contain secrets.

# --- Supabase (required for app + most API routes) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public site URL (optional; defaults used in code if unset) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Email (Brevo SMTP) — used by app/api/send_email ---
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=your-brevo-smtp-login
BREVO_PASS=your-brevo-smtp-password

# --- MongoDB (optional — lib/mongodb.js is not imported elsewhere yet) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# --- Scripts only (optional) ---
# TEST_USER_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
